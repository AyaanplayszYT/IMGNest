NODE_ENV=development
ENABLE_SCHEDULER=false

PORT=3000
HOST=0.0.0.0

SCRAPY_CLOUD_API_KEY=
SCRAPY_CLOUD_PROJECT_ID=
SCRAPY_CLOUD_SPIDER=imgnest_images
SCRAPY_CLOUD_TIMEOUT_MS=120000
SCRAPY_CLOUD_POLL_INTERVAL_MS=1000
DATABASE_PATH=./data/dev.db
IMAGE_STORAGE_PATH=./data/images
TEMP_STORAGE_PATH=./data/tmp
MAX_STORAGE_MB=9000

# Wikimedia Commons CC-Zero category. The spider samples file pages and checks
# their per-file CC0 metadata. Provide a contact for Wikimedia's User-Agent policy.
CRAWLER_SOURCE_URL=https://commons.wikimedia.org/wiki/Category:CC-Zero
CRAWLER_SOURCE_NAME=Wikimedia Commons
CRAWLER_SOURCE_LICENSE=CC0 1.0
CRAWLER_CONTACT_EMAIL=
CRAWLER_HISTORICAL_BEFORE_YEAR=1990
CRAWLER_MAX_ITEMS=5
CRAWLER_MAX_DOWNLOADS=5
CRAWLER_MAX_PAGES=1
CRAWLER_MAX_REQUESTS=5

TEST_MAX_ITEMS=3
TEST_MAX_DOWNLOADS=3
TEST_MAX_PAGES=1

MAX_FILE_SIZE_MB=10
MAX_IMAGE_WIDTH=3000
MAX_IMAGE_HEIGHT=3000

IMAGE_DOWNLOAD_TIMEOUT_MS=15000
CRAWLER_INTERVAL_MINUTES=60
